{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "video-processor-worker-group",
    "MinioVideoUploadedTopic": "minio.video.uploaded"
  },
  "Minio": {
    "Endpoint": "127.0.0.1:9000",
    "AccessKey": "minio_admin",
    "SecretKey": "minio_password",
    "UseSsl": false
  },
  "Whisper": {
    "ModelPath": "ggml-medium.bin",
    "AutoDownloadModelType": "medium",
    "DefaultLanguage": "auto",
    "UseGpu": true
  },
  "Ffmpeg": {
    "FfmpegPath": "ffmpeg",
    "EnableGpuAcceleration": true
  },
  "ConnectionStrings": {
    "VideoServiceDb": "Host=localhost;Port=5434;Database=video_db;Username=video_user;Password=video_pass"
  }
}

