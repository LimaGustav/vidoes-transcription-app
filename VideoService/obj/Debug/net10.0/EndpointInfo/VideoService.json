{
  "openapi": "3.1.1",
  "info": {
    "title": "VideoService | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5034"
    }
  ],
  "paths": {
    "/api/videos/upload": {
      "post": {
        "tags": [
          "Videos"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestUploadRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestUploadRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RequestUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RequestUploadResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestUploadResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestUploadResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/videos/{videoId}/stream": {
      "get": {
        "tags": [
          "Videos"
        ],
        "parameters": [
          {
            "name": "videoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/StreamVideoResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamVideoResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamVideoResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RequestUploadRequest": {
        "required": [
          "title",
          "contentType"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "contentType": {
            "type": "string"
          },
          "categoryId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "RequestUploadResponse": {
        "type": "object",
        "properties": {
          "videoId": {
            "type": "string",
            "format": "uuid"
          },
          "uploadUrl": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "StreamVideoResponse": {
        "type": "object",
        "properties": {
          "streamUrl": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Insira o token JWT (sem o prefixo 'Bearer ')",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ],
  "tags": [
    {
      "name": "Videos"
    }
  ]
}