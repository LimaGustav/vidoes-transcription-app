{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Yarp": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "video-route": {
        "ClusterId": "video-cluster",
        "Match": {
          "Path": "/api/videos/{**catch-all}"
        }
      },
      "stream-route": {
        "ClusterId": "video-cluster",
        "Match": {
          "Path": "/stream/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5091/"
          }
        }
      },
      "video-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5011/"
          }
        }
      }
    }
  },
  "JwtSettings": {
    "Authority": "http://auth-service",
    "Audience": "streaming-bff",
    "SecretKey": "SuaChaveSuperSecretaComPeloMenos32Caracteres",
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true,
    "ClockSkewSeconds": 30
  },
  "RateLimitSettings": {
    "PolicyName": "ApiPolicy",
    "PermitLimit": 100,
    "WindowInSeconds": 60,
    "QueueLimit": 10,
    "SegmentsPerWindow": 4,
    "AutoReplenishment": true
  }
}